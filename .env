

# Which backend the notebooks use by default: "ollama" or "litellm".
# You can always override it per call:  get_chat_model(backend="litellm")
WORKSHOP_BACKEND=ollama

# --- Option A: Ollama (runs on your own machine, no key needed) ------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:2b
# A "thinking out loud" model, used in notebook 06.
# deepseek-r1:1.5b is quick enough for a live workshop; deepseek-r1:8b is
# noticeably better and noticeably slower (1-2 minutes per answer).
OLLAMA_REASONING_MODEL=deepseek-r1:1.5b

# --- Option B: LiteLLM proxy (a shared server, needs the workshop key) -----
LITELLM_BASE_URL=https://llm.mlcloud.uni-tuebingen.de/v1
LITELLM_API_KEY=sk-replaceme
# Whatever your key is allowed to use. Leave empty to auto-pick the first
# model the server offers you (notebook 01 prints the list).
LITELLM_CHAT_MODEL=Qwen/Qwen3.6-35B-A3B

# --- Embedding models (notebooks 03 & 04). Ollama only, on purpose: ---------
# they are small, fast, and let us compare three of them side by side.
EMBED_MODELS=nomic-embed-text:latest,qwen3-embedding:0.6b,all-minilm:33m
